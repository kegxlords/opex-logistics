# Server-only Vercel variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# cPanel relay: the relay file uses cPanel's outbound IP; it does not store MGM credentials.
MGM_PROXY_URL=https://your-cpanel-domain.example/mgm-gateway-proxy.php
MGM_PROXY_SHARED_SECRET=

# MGM Pay credentials and callback URLs, sent from Vercel to the authenticated relay.
MGM_PAY_BASE_URL=https://api.mgm-paysandbox.com
MGM_PAY_MERCHANT_NO=
MGM_PAY_APP_ID=
MGM_PAY_COLLECTION_KEY=
MGM_PAY_PAYOUT_KEY=
MGM_PAY_DEPOSIT_NOTIFICATION_URL=https://your-domain.example/api/webhooks/mgm?type=deposit
MGM_PAY_WITHDRAWAL_NOTIFICATION_URL=https://your-domain.example/api/webhooks/mgm?type=withdrawal
MGM_PAY_SUCCESS_REDIRECT_URL=https://your-domain.example/payments/return
